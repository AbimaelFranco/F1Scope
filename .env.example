# Copy this file to .env and adjust as needed.
# .env is git-ignored — never commit real secrets here.

FLASK_ENV=development
FLASK_APP=wsgi.py

# Used to sign sessions/cookies. Set a real random value outside development.
SECRET_KEY=change-me-in-production

# OpenF1 is a public, read-only, free-tier API — no key required for v1.
OPENF1_BASE_URL=https://api.openf1.org/v1

# Local session cache. Mapped to a Docker volume in docker-compose so
# ingested sessions survive container restarts.
CACHE_DIR=instance/cache
